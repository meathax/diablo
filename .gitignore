/reports/
/distribution/
/pc-process-*.json
/NUL

# Keep the public entry-point README and legal notices; omit working docs.
*.md
!/README.md
!/LICENSE.fpga
!/support/licenses/
!/support/licenses/**
*.rst
*.adoc
/support/qualification/
