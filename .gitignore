/game/
/ready/
*.mpq
*.MPQ
*.clx
*.CLX
*.iso
*.ISO
*.zip
*.ZIP
/.work/

# Quartus and simulation output; keep project inputs and HDL sources.
/db/
/incremental_db/
/output_files/
*.rpt
*.summary
*.jdi
*.sof
*.pof
*.rbf
*.qws
*.pyc
**/__pycache__/
